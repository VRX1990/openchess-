{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible OpenChess player profile and rating summary (no PII).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the player.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique OpenChess handle.",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "country": {
          "type": "string",
          "description": "ISO country code or INT.",
          "minLength": 2,
          "maxLength": 8,
          "pattern": "^[A-Z]{2,8}$"
        },
        "bio": {
          "type": "string",
          "description": "Player bio shown on profile.",
          "minLength": 0,
          "maxLength": 240
        },
        "rapidRating": {
          "type": "number",
          "description": "Current Rapid rating."
        },
        "blitzRating": {
          "type": "number",
          "description": "Current Blitz rating."
        },
        "bulletRating": {
          "type": "number",
          "description": "Current Bullet rating."
        },
        "puzzleRating": {
          "type": "number",
          "description": "Current Puzzle rating."
        },
        "leaguePoints": {
          "type": "number",
          "description": "Accumulated league points."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "username",
        "country",
        "rapidRating",
        "blitzRating",
        "bulletRating",
        "puzzleRating",
        "leaguePoints",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Isolated private account verification data containing PII (email).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address.",
          "minLength": 6,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "email", "createdAt", "updatedAt"]
    },
    "UserFriendEntry": {
      "title": "UserFriendEntry",
      "description": "Persisted friend relationship, pending outgoing request, or removal marker owned by the player.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "friendUsername": {
          "type": "string",
          "description": "Target player username.",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Relationship state: friend, outgoing, or removed.",
          "minLength": 6,
          "maxLength": 8,
          "pattern": "^(friend|outgoing|removed)$"
        },
        "updatedAt": {
          "type": "number",
          "description": "Epoch millisecond update timestamp."
        }
      },
      "required": ["ownerId", "friendUsername", "status", "updatedAt"]
    },
    "UserPlayedGame": {
      "title": "UserPlayedGame",
      "description": "Persisted played chess match record owned by the player.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gameId": {
          "type": "string",
          "description": "Unique match identifier.",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rated": {
          "type": "boolean",
          "description": "Whether match was rated."
        },
        "speed": {
          "type": "string",
          "description": "Time control speed category.",
          "minLength": 5,
          "maxLength": 14,
          "pattern": "^(bullet|blitz|rapid|classical|correspondence)$"
        },
        "status": {
          "type": "string",
          "description": "Game termination status.",
          "minLength": 2,
          "maxLength": 32
        },
        "winner": {
          "type": "string",
          "description": "Winner side if decisive.",
          "minLength": 4,
          "maxLength": 5,
          "pattern": "^(white|black|draw)$"
        },
        "whiteName": {
          "type": "string",
          "description": "White player name.",
          "minLength": 1,
          "maxLength": 40
        },
        "blackName": {
          "type": "string",
          "description": "Black player name.",
          "minLength": 1,
          "maxLength": 40
        },
        "whiteRating": {
          "type": "number",
          "description": "White player Elo rating."
        },
        "blackRating": {
          "type": "number",
          "description": "Black player Elo rating."
        },
        "opening": {
          "type": "string",
          "description": "Opening name if detected.",
          "minLength": 0,
          "maxLength": 120
        },
        "pgn": {
          "type": "string",
          "description": "Full game PGN.",
          "minLength": 4,
          "maxLength": 12000
        },
        "createdAt": {
          "type": "number",
          "description": "Epoch millisecond start time."
        },
        "lastMoveAt": {
          "type": "number",
          "description": "Epoch millisecond last move time."
        }
      },
      "required": [
        "ownerId",
        "gameId",
        "rated",
        "speed",
        "status",
        "whiteName",
        "blackName",
        "pgn",
        "createdAt",
        "lastMoveAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public player profile documents keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Private PII subcollection accessible only to the authenticated owner."
    },
    "/users/{userId}/friends/{friendKey}": {
      "schema": { "$ref": "#/entities/UserFriendEntry" },
      "description": "Owner-scoped friends, outgoing requests, and removed markers persisted across sessions."
    },
    "/users/{userId}/games/{gameId}": {
      "schema": { "$ref": "#/entities/UserPlayedGame" },
      "description": "Owner-scoped recent played chess matches persisted across sessions."
    }
  }
}
